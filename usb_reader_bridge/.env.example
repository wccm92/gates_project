READER_MODE=hid

# Symbol Technologies Bar Code Scanner (05e0:1200) — found via `lsusb`
READER_HID_VID=0x05e0
READER_HID_PID=0x1200

# Optional: pin to a specific /dev/input/eventX (more reliable than VID/PID)
# Run `cat /proc/bus/input/devices` to find the right eventX for your scanner
# READER_HID_DEVICE=/dev/input/event13

LOG_LEVEL=INFO
