# ============================================================
# Standalone bridge unit — deploy as a pipeline with ms-gates.
#
# OPTION A (recommended for phase 1): one combined unit
#   ExecStart=/bin/sh -c 'python3 -u /opt/usb-reader-bridge/src/main.py \
#                         | java -jar /opt/ms-gates/ms-gates.jar'
#   Both processes restart together on any failure.
#
# OPTION B: two independent units connected via a named FIFO
#   1. Create the FIFO once:
#        mkfifo /run/gates/reader.fifo
#   2. Start ms-gates reading from it:
#        ExecStart=java -jar /opt/ms-gates/ms-gates.jar
#        StandardInput=file:/run/gates/reader.fifo   (in ms-gates.service)
#   3. Start this bridge writing to it:
#        ExecStart=python3 -u /opt/usb-reader-bridge/src/main.py \
#                  > /run/gates/reader.fifo
#   Each unit restarts independently.
# ============================================================

[Unit]
Description=USB Reader Bridge for Gates Access Control
After=network.target

[Service]
Type=simple
User=gates
# HID access  : sudo usermod -aG input  gates
# Serial access: sudo usermod -aG dialout gates
WorkingDirectory=/opt/usb-reader-bridge
ExecStart=/usr/bin/python3 -u src/main.py
Restart=always
RestartSec=3
EnvironmentFile=/etc/gates/bridge.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
