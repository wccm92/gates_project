# -------- Base de datos EN LA NUBE (origen, solo lectura) --------
REMOTE_DB_HOST=86.48.21.61
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=db_edcph
REMOTE_DB_USERNAME=usrapps
REMOTE_DB_PASSWORD=cámbiame

# -------- Base de datos LOCAL (destino) --------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=edc_local
LOCAL_DB_USERNAME=edc
LOCAL_DB_PASSWORD=cámbiame

# -------- Config del servicio (lo ÚNICO que cambia por máquina) --------
# 1=OCCIDENTAL  2=ORIENTAL  3=NORTE  4=SUR
TRIBUNA_ID=1

# -------- Ajustes finos (opcionales) --------
# IMPORTANTE: no pongas comentarios en la MISMA línea que un valor; systemd
# los incluye dentro del valor y el arranque falla. Comenta en líneas aparte.
# POLL_INTERVAL      = segundos entre lecturas del outbox
# RECONCILE_INTERVAL = segundos entre snapshots completos (0 = desactivar)
# BATCH_SIZE         = filas por lote de poll
# RETRY_BACKOFF      = segundos de espera tras un error de conexión
POLL_INTERVAL=5
RECONCILE_INTERVAL=300
BATCH_SIZE=500
RETRY_BACKOFF=10
LOG_LEVEL=INFO
